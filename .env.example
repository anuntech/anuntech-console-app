# Anuntech Console — configuração do aplicativo e reservas para integrações futuras.
# Não versionar valores reais. Não usar NEXT_PUBLIC_ para segredos.
# Produção: BETTER_AUTH_URL=https://console.anuntech.com
# GitHub, Vercel e Cloudflare: credenciais de infraestrutura não pertencem ao runtime.
# Anexos, agendamento e autenticação de webhooks: definir ao implementar.

# Aplicação e banco
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=
DATABASE_URL=

# Google OAuth — callback: /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — remetente em domínio verificado
RESEND_API_KEY=
EMAIL_FROM=

# Fotos de perfil: Vercel Blob privado conectado ao projeto por OIDC.
# VERCEL_OIDC_TOKEN é fornecido pela plataforma; nunca copiar para NEXT_PUBLIC_.
BLOB_STORE_ID=

# Inter — autenticação mTLS e cobrança manual. Use ambiente/credenciais correspondentes.
INTER_API_BASE_URL=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERTIFICATE_BASE64=
INTER_PRIVATE_KEY_BASE64=

# Focus NFe — homologação; credenciais de produção devem ser separadas
FOCUS_NFE_BASE_URL=https://homologacao.focusnfe.com.br
# Tokens separados por ambiente; mantenha homologação durante a implementação.
FOCUS_NFE_TOKEN_PRODUCTION=
FOCUS_NFE_TOKEN_HOMOLOGATION=
FOCUS_NFE_ISSUER_CNPJ=

# WhatsApp FLW — API WTS; canais de WhatsApp usam /chat/v1
FLW_API_BASE_URL=
# Token de integração FLW/Synova
FLW_SYNOVA=
FLW_INSTANCE_ID=
FLW_SENDER_NUMBER=
# Modelo aprovado do tipo AUTHENTICATION para envio de códigos.
FLW_OTP_TEMPLATE_ID=
# UUID do modelo notificação_chamado_console no FLW.
FLW_TICKET_TEMPLATE_ID=
# Autoriza exclusivamente o processamento periódico dos avisos na Vercel.
CRON_SECRET=

# E-mail protegido do proprietário inicial; novos administradores são gerenciados em Ajustes > Membros.
CONSOLE_ADMIN_EMAIL=

# Ambiente fiscal e certificados locais Inter (caminhos não disponíveis na Vercel).
# Campos BASE64 usados na Vercel; caminhos locais não são enviados ao deploy.
FOCUS_NFE_ENVIRONMENT=homologation
INTER_CERTIFICATE_PATH=
INTER_PRIVATE_KEY_PATH=
INTER_WEBHOOK_CA_PATH=
INTER_WEBHOOK_CA_BASE64=
