# Anuntech Console — configuração do aplicativo e reservas para integrações futuras.
# Não versionar valores reais. Não usar NEXT_PUBLIC_ para segredos.
# Produção: BETTER_AUTH_URL=https://console.anuntech.com
# GitHub, Vercel e Cloudflare: credenciais de infraestrutura não pertencem ao runtime.
# Anexos, agendamento e autenticação de webhooks: definir ao implementar.

# Aplicação e banco
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=
DATABASE_URL=

# Google OAuth — callback: /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — remetente em domínio verificado
RESEND_API_KEY=
EMAIL_FROM=

# Fotos de perfil: Vercel Blob privado conectado ao projeto por OIDC.
# VERCEL_OIDC_TOKEN é fornecido pela plataforma; nunca copiar para NEXT_PUBLIC_.
BLOB_STORE_ID=

# Inter — autenticação mTLS e cobrança manual. Use ambiente/credenciais correspondentes.
INTER_API_BASE_URL=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERTIFICATE_BASE64=
INTER_PRIVATE_KEY_BASE64=

# Focus NFe — homologação; credenciais de produção devem ser separadas
FOCUS_NFE_BASE_URL=https://homologacao.focusnfe.com.br
# Tokens separados por ambiente; mantenha homologação durante a implementação.
FOCUS_NFE_TOKEN_PRODUCTION=
FOCUS_NFE_TOKEN_HOMOLOGATION=
FOCUS_NFE_ISSUER_CNPJ=

# WhatsApp FLW — API WTS; canais de WhatsApp usam /chat/v1
FLW_API_BASE_URL=
# Token de integração FLW/Synova
FLW_SYNOVA=
FLW_INSTANCE_ID=
FLW_SENDER_NUMBER=
# Modelo aprovado do tipo AUTHENTICATION para envio de códigos.
FLW_OTP_TEMPLATE_ID=
# UUID do modelo notificação_chamado_console no FLW.
FLW_TICKET_TEMPLATE_ID=
# Autoriza exclusivamente o processamento periódico dos avisos na Vercel.
CRON_SECRET=

# E-mail protegido do proprietário inicial; novos administradores são gerenciados em Ajustes > Membros.
CONSOLE_ADMIN_EMAIL=

# Ambiente fiscal e certificados locais Inter (caminhos não disponíveis na Vercel).
# Campos BASE64 usados na Vercel; caminhos locais não são enviados ao deploy.
FOCUS_NFE_ENVIRONMENT=homologation
INTER_CERTIFICATE_PATH=
INTER_PRIVATE_KEY_PATH=
INTER_WEBHOOK_CA_PATH=
INTER_WEBHOOK_CA_BASE64=

# AI Gateway da Vercel: toda a IA do Console (assistente, Jev, ditado, sugestões, jornadas e ícones).
# Em produção na Vercel, o projeto se autentica sozinho por OIDC: não crie chave lá. Um preview só tem IA com chave ou token próprio.
# Local: `vercel env pull` grava VERCEL_OIDC_TOKEN (vale 12 horas), ou use uma chave do painel em AI_GATEWAY_API_KEY.
# Com a chave preenchida, ela vale no lugar do OIDC, mesmo se for inválida.
AI_GATEWAY_API_KEY=
# Jev (intenção no assistente e triagem de chamados). ASSISTANT_JEV=off desliga; modelo padrão typesafe-ai/jev.
ASSISTANT_JEV=
ASSISTANT_JEV_MODEL=
# Ditado por microfone (assistente e abrir chamado). Liga sozinho com o AI Gateway; VOICE_INPUT=off desliga.
# Modelos de transcrição (padrão microsoft/mai-transcribe-2, reserva spacexai/grok-stt; off desliga a reserva):
# precisam ter provedor de retenção zero no AI Gateway.
VOICE_INPUT=
VOICE_MODEL=
VOICE_FALLBACK_MODEL=

# Passe do Console — apps dos clientes que só abrem dentro do Console (lib/apps).
# Chave RSA de 2048 bits ou mais, PKCS#8 em PEM, codificada em base64 numa linha:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
# A parte pública sai em /.well-known/jwks.json. Sem as duas, nenhum app abre (falha fechado).
# Na Vercel, só no ambiente Production: o iss é fixo, então um passe assinado num preview com a mesma chave valeria nos apps.
APP_PASS_PRIVATE_KEY=
# Identificador da chave (kid) no cabeçalho do passe e na JWKS; troque junto com a chave.
APP_PASS_KEY_ID=
# Só para teste local: aponta um app para uma cópia local, ex. {"espaco-absolut-cms":"http://localhost:4001"}.
# Ignorado em produção na Vercel.
CONSOLE_APP_ORIGINS=
# Ícones do catálogo gerados com IA (Configurações › Catálogo). Ligam sozinhos com o AI Gateway; ICON_AI=off desliga.
ICON_AI=
# Modelo de imagem do AI Gateway (padrão recraft/recraft-v4.1-flash) e o reserva (padrão openai/gpt-image-1-mini; off desliga).
ICON_MODEL=
ICON_FALLBACK_MODEL=
# Conta do revisor da App Store e do Google Play: esse número de WhatsApp entra com o código fixo, sem mensagem.
# Desligado com qualquer um vazio. Use um número da Anuntech, ligado só à conta da empresa de demonstração.
APP_REVIEW_PHONE=
# Seis números. Vai só nas notas de revisão das lojas; trocar depois de cada revisão aprovada.
APP_REVIEW_CODE=
# Links que abrem o app nativo (/.well-known). Sem eles, as rotas respondem 404.
# Team ID da Apple (10 caracteres) e o SHA-256 do certificado de assinatura do Android (do EAS ou do Play), separados por vírgula.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
